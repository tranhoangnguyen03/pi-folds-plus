    "url": "git+https://github.com/tranhoangnguyen03/pi-folds-plus.git"
  },
  "bugs": "https://github.com/tranhoangnguyen03/pi-folds-plus/issues",
  "homepage": "https://github.com/tranhoangnguyen03/pi-folds-plus#readme",
